# =============================================================================
# ex-voice-web — variáveis de ambiente
# NEXT_PUBLIC_* vai para o bundle do navegador (NUNCA colocar segredo real).
# =============================================================================

# API do produto (dev: http://localhost:3333)
NEXT_PUBLIC_API_URL="https://voice-api.executivosdigital.com.br"

# Identidade do app
PROJECT_NAME="Ex Voice"
# NEXT_PUBLIC_APP_NAME="Ex Voice"
# NEXT_PUBLIC_APP_URL="https://voice.executivosdigital.com.br"
# PRIMARY_COLOR=""

# Social login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_APPLE_CLIENT_ID=""
NEXT_PUBLIC_APPLE_REDIRECT_URI=""

# OpenRouter/OpenAI (server-side)
OPENROUTER_API_KEY=""
# OPENAI_API_KEY=""

# ⚠ DÍVIDA (chat-handler.tsx): a chave OpenRouter também é lida como
# NEXT_PUBLIC_* — ou seja, exposta no bundle do client. Mover a chamada para
# uma route handler server-side e rotacionar a chave. Ver FASE-0.md.
# NEXT_PUBLIC_OPENROUTER_API_KEY=""
# NEXT_PUBLIC_OPENROUTER_MODEL=""
# NEXT_PUBLIC_USER_TOKEN=""
